{
  "name": "workout-app",
  "private": true,
  "version": "3.0.940",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:production",
    "android:sync": "npx cap sync android",
    "android:build": "node scripts/prepare-android-version.mjs --write && npm run build:production && npx cap sync android && node scripts/prepare-android-version.mjs",
    "android:open": "npx cap open android",
    "build:staging": "node scripts/build-firebase-artifact.mjs --environment=staging",
    "build:production": "node scripts/build-firebase-artifact.mjs --environment=production",
    "import:exercise-catalog": "node scripts/import-free-exercise-catalog.mjs",
    "build:basic-workout-ai-catalogue": "node scripts/build-basic-workout-ai-catalogue.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "node scripts/run-firestore-rules.mjs",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "verify": "node scripts/verify.mjs --profile=release",
    "verify:full": "node scripts/verify.mjs --profile=full --e2e",
    "verify:core": "node scripts/verify.mjs --profile=full",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "check:functions": "node scripts/check-functions-syntax.mjs",
    "check:firebase-artifact": "node scripts/assert-firebase-deploy.mjs",
    "report:css": "node scripts/report-css-size.mjs",
    "audit:production": "npm audit --cache ./.npm-cache --omit=dev",
    "audit:all": "npm audit --cache ./.npm-cache",
    "audit:functions": "node scripts/audit-functions.mjs",
    "lint": "eslint .",
    "lint:critical": "eslint src/utils/clientUx.js src/utils/trainerAttention.js src/utils/trainerNutritionPlan.js tests/client-ux.test.mjs tests/trainer-attention.test.mjs tests/trainer-nutrition-plan.test.mjs tests/security-boundaries.test.mjs tests/firestore-rules.rules.mjs tests/e2e/client-smoke.spec.js tests/e2e/trainer-workspace.spec.js playwright.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@simplewebauthn/browser": "14.0.0",
    "firebase": "^12.12.1",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "morphicons": "^1.7.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "read-excel-file": "^9.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "protobufjs": "7.6.5",
    "xcode": {
      "uuid": "11.1.1"
    },
    "websocket-driver": "0.7.5"
  }
}
