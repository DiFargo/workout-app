# Copy this file to .env.local for local development, or to
# .env.staging.local for a staging build. Never commit the *.local file.
#
# Allowed values: development, staging, e2e, production.
# Development, staging and e2e always require all Firebase values below and
# must point to a non-production project.
VITE_FIREBASE_ENVIRONMENT=development
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional App Check reCAPTCHA Enterprise site key. It is public, but must be
# registered for the exact Firebase web app and environment. Leave blank until
# the App Check monitoring rollout is configured.
VITE_APP_CHECK_SITE_KEY=

# Optional local development debug token. Never use this in a deployable build
# (staging or production) and never commit a real token. The build rejects it.
VITE_APP_CHECK_DEBUG_TOKEN=

# Optional Hosting/emulator origin used by Vite's local /api proxy. This keeps
# local development pointed at a non-production environment, for example
# https://your-staging-project.web.app.
VITE_API_BASE_URL=

# Optional HTTPS (or same-origin) collector for compact, redacted client error
# reports. Leave empty to disable all network error reporting.
VITE_ERROR_REPORTING_ENDPOINT=
