rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data;
    }

    function hasActiveMembershipData(data) {
      return data.keys().hasAll(["role"]) &&
        data.role in ["client", "trainer", "admin"] &&
        (!data.keys().hasAll(["active"]) || data.active != false) &&
        (!data.keys().hasAll(["archived"]) || data.archived != true) &&
        (!data.keys().hasAll(["accessDisabled"]) || data.accessDisabled != true) &&
        (!data.keys().hasAll(["membershipStatus"]) ||
          !(data.membershipStatus in ["revoked", "suspended"]));
    }

    function isActiveMember() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        hasActiveMembershipData(userData(request.auth.uid));
    }

    function isOwner(uid) {
      return isActiveMember() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isActiveMember() && request.auth.token.admin == true;
    }

    function isTrainer() {
      return isActiveMember() && userData(request.auth.uid).role == "trainer";
    }

    function isOwnerOrAdmin(uid) {
      return isOwner(uid) || isAdmin();
    }

    function hasAssignedTrainerId(data) {
      return data.keys().hasAll(["assignedTrainerId"]) &&
        data.assignedTrainerId is string &&
        data.assignedTrainerId.size() > 0;
    }

    function hasTrainerId(data) {
      return data.keys().hasAll(["trainerId"]) &&
        data.trainerId is string &&
        data.trainerId.size() > 0;
    }

    function hasCoachId(data) {
      return data.keys().hasAll(["coachId"]) &&
        data.coachId is string &&
        data.coachId.size() > 0;
    }

    function hasCreatedByUid(data) {
      return data.keys().hasAll(["createdByUid"]) &&
        data.createdByUid is string &&
        data.createdByUid.size() > 0;
    }

    // An explicit lifecycle state is authoritative. Historical creator fields
    // remain for audit purposes but must never retain a former trainer's access
    // after the client has been unassigned or revoked.
    function hasExplicitTrainerAssignmentState(data) {
      return data.keys().hasAll(["trainerAssignmentState"]) &&
        data.trainerAssignmentState is string &&
        data.trainerAssignmentState in ["assigned", "unassigned", "revoked"];
    }

    function hasResolvedAssignedTrainer(data) {
      return hasExplicitTrainerAssignmentState(data)
        ? data.trainerAssignmentState == "assigned" && (
          (hasAssignedTrainerId(data) && data.assignedTrainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && hasTrainerId(data) && data.trainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) &&
            hasCoachId(data) && data.coachId == request.auth.uid)
        )
        : (
          (hasAssignedTrainerId(data) && data.assignedTrainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && hasTrainerId(data) && data.trainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) &&
            hasCoachId(data) && data.coachId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) && !hasCoachId(data) &&
            hasCreatedByUid(data) && data.createdByUid == request.auth.uid)
        );
    }

    function isAssignedTrainer(uid) {
      let client = userData(uid);
      return isTrainer() && hasResolvedAssignedTrainer(client);
    }

    function isImage() {
      return request.resource.contentType.matches("image/(jpeg|png|webp)");
    }

    function isProfileAvatar() {
      return isImage() && request.resource.size < 5 * 1024 * 1024;
    }

    function isProgressPhoto() {
      return request.resource.contentType == "image/webp" &&
        request.resource.size < 10 * 1024 * 1024;
    }

    function isFeedbackAttachment() {
      return request.resource.size < 25 * 1024 * 1024 &&
        (
          request.resource.contentType.matches("image/(jpeg|png|webp)") ||
          request.resource.contentType.matches("video/(mp4|webm|quicktime)") ||
          request.resource.contentType == "application/pdf" ||
          request.resource.contentType == "text/plain"
        );
    }

    function isExerciseVideo() {
      return request.resource.size < 250 * 1024 * 1024 &&
        request.resource.contentType.matches("video/(mp4|webm|quicktime)");
    }

    function isCatalogImage() {
      return isImage() && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isOwnerOrAdmin(uid);
      allow create, update: if isOwnerOrAdmin(uid) && isProfileAvatar();
      allow delete: if isOwnerOrAdmin(uid);
    }

    match /progress-photos/{uid}/{photoId}/{fileName} {
      allow read: if isOwnerOrAdmin(uid) || (isTrainer() && isAssignedTrainer(uid));
      allow create, update: if (isOwnerOrAdmin(uid) || (isTrainer() && isAssignedTrainer(uid))) &&
        isProgressPhoto();
      allow delete: if isOwnerOrAdmin(uid) || (isTrainer() && isAssignedTrainer(uid));
    }

    match /feedback/{uid}/{allPaths=**} {
      allow read: if isOwnerOrAdmin(uid);
      allow create, update: if isOwnerOrAdmin(uid) && isFeedbackAttachment();
      allow delete: if isOwnerOrAdmin(uid);
    }

    match /workout-videos/{allPaths=**} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() && isExerciseVideo();
      allow delete: if isAdmin();
    }

    match /exercise-videos/{ownerUid}/{programId}/{allPaths=**} {
      allow read: if isActiveMember();
      allow create, update: if (isAdmin() || (isTrainer() && isOwner(ownerUid))) &&
        isExerciseVideo();
      allow delete: if isAdmin() || (isTrainer() && isOwner(ownerUid));
    }

    match /template-exercise-videos/{ownerUid}/{programId}/{allPaths=**} {
      allow read: if isActiveMember();
      allow create, update: if (isAdmin() || (isTrainer() && isOwner(ownerUid))) &&
        isExerciseVideo();
      allow delete: if isAdmin() || (isTrainer() && isOwner(ownerUid));
    }

    match /exercise-videos/{allPaths=**} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() && isExerciseVideo();
      allow delete: if isAdmin();
    }

    match /basic-exercise-assets/{exerciseId}/images/{fileName} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() && isCatalogImage();
      allow delete: if isAdmin();
    }

    match /basic-exercise-assets/{exerciseId}/videos/{fileName} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() && isExerciseVideo();
      allow delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
