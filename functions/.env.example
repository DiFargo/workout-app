# Firebase Functions non-secret parameters. Copy to .env.<project-id> in this
# directory; never commit the environment-specific file.
#
# Keep false while monitoring App Check. Set true only after the corresponding
# web app is registered and all client/staging checks send valid tokens.
APP_CHECK_ENFORCED=false

# Optional overrides. Empty URL/bucket/domain values derive from the deployed
# Firebase project. Staging must set its own web API key so invite activation
# never talks to production Identity Toolkit.
WORKOUT_APP_URL=
WORKOUT_WEB_API_KEY=
WORKOUT_STORAGE_BUCKET=
INVITE_LOGIN_EMAIL_DOMAIN=
TELEGRAM_WEBHOOK_URL=
