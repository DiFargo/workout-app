rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAuthenticatedOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasActiveMembershipData(data) {
      let role = data.get("role", "");
      return role in ["client", "trainer", "admin"] &&
        data.get("accountAccessStatus", "") != "awaiting_trainer" &&
        !(role == "client" && data.get("trainerAssignmentState", "") == "unassigned") &&
        data.get("active", true) != false && data.get("archived", false) != true &&
        data.get("accessDisabled", false) != true &&
        !(data.get("membershipStatus", "") in ["revoked", "suspended"]);
    }

    function isActiveMember() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        hasActiveMembershipData(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function isOwner(uid) {
      return isAuthenticatedOwner(uid) && isActiveMember();
    }

    function isAdmin() {
      return signedIn() && "admin" in request.auth.token && request.auth.token.admin == true &&
        isActiveMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
        hasCurrentAdminClaimVersion(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ) && hasCurrentAdminSecurityKeyProof(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    // Enrollment is server-owned. Unenrolled administrators retain their
    // existing access; enrolled administrators must prove this bounded session.
    function hasCurrentAdminSecurityKeyProof(data) {
      let required = data.get("adminSecurityKeyRequired", false);
      let version = data.get("adminSecurityKeyVersion", "");
      let roleVersion = request.auth.token.get("adminSecurityKeyRoleVersion", "");
      let until = request.auth.token.get("adminSecurityKeyUntil", 0);
      return required == false || (required == true &&
        version is string && version.size() > 0 && version.size() <= 256 &&
        request.auth.token.get("adminSecurityKeyVersion", "") == version &&
        roleVersion is string && roleVersion == data.get("adminClaimVersion", "legacy") &&
        until is int && until > request.time.toMillis() &&
        until <= request.time.toMillis() + 8 * 60 * 60 * 1000);
    }

    function adminSecurityKeyFields() {
      return ["adminSecurityKeyRequired", "adminSecurityKeyVersion", "adminSecurityKeyUpdatedAt"];
    }

    function hasCurrentAdminClaimVersion(data) {
      return data.keys().hasAll(["adminClaimVersion"])
        ? data.adminClaimVersion is string &&
          "adminClaimVersion" in request.auth.token &&
          request.auth.token.adminClaimVersion == data.adminClaimVersion
        : !("adminClaimVersion" in request.auth.token);
    }

    function isTrainer() {
      return isActiveMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "trainer";
    }

    function isOwnerOrAdmin(uid) {
      return isOwner(uid) || isAdmin();
    }

    // Used only during an explicit accounting cutover; normal operation has
    // no maintenance document or paused:false. Existing workout drafts remain local.
    function accountingWritesAvailable() {
      return !exists(/databases/$(database)/documents/serverConfig/subscriptionAccounting) ||
        get(/databases/$(database)/documents/serverConfig/subscriptionAccounting).data.get("paused", false) != true;
    }

    function nutritionSdkWriteAvailable(uid, docId) {
      let manifestPath = /databases/$(database)/documents/users/$(uid)/nutrition/manifest;
      return docId != "manifest" && (docId != "state" ||
        !exists(manifestPath) ||
        (get(manifestPath).data.get("sourceOfTruth", "legacy") == "legacy" &&
          get(manifestPath).data.get("writerEpoch", 0) == 0));
    }

    function protectedUserFields() {
      return [
        "loginLower",
        "email",
        "profileIdentityOperation",
        "isTest",
        "role",
        "accountRegistrationType",
        "accountAccessStatus",
        "trainerId",
        "assignedTrainerId",
        "coachId",
        "trainerAssignmentState",
        "createdByUid",
        "assignedProgramId",
        "assignedProgramName",
        "assignedProgramAt",
        "assignedProgramUpdatedAt",
        "assignedProgramLifecycleStatus",
        "assignedProgramVisibility",
        "assignedProgramPublishedAt",
        "assignedProgramAssignedByUid",
        "assignedWorkoutCount",
        "adminClaimUpdatedAt",
        "adminClaimVersion",
        "adminSecurityKeyRequired",
        "adminSecurityKeyVersion",
        "adminSecurityKeyUpdatedAt",
        "trainerRoleUpdatedAt",
        "subscription",
        "telegram",
        "telegramConnected",
        "telegramUsername",
        "telegramDisplayName",
        "telegramAvatarUrl",
        "telegramUserId",
        "telegramChatId",
        "telegramLinkedAt",
        "telegramLinkCode",
        "telegramLinkCodeCreatedAt",
        "telegramLinkCodeExpiresAt",
        "telegramNotificationsEnabled",
        "telegramNotificationsUpdatedAt",
        "telegramDisconnectedAt"
      ];
    }

    function isSafeOwnerCreate(uid) {
      return isAuthenticatedOwner(uid) &&
        (!request.resource.data.keys().hasAny(protectedUserFields()) ||
          request.resource.data.role == "client") &&
        !request.resource.data.keys().hasAny([
          "trainerId",
          "assignedTrainerId",
          "coachId",
          "trainerAssignmentState",
          "createdByUid",
          "assignedProgramId",
          "assignedProgramName",
          "assignedProgramAt",
          "assignedProgramAddedAt",
          "assignedProgramUpdatedAt",
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedProgramPublishedAt",
          "assignedProgramAssignedByUid",
          "assignedWorkoutCount",
          "adminClaimUpdatedAt",
          "trainerRoleUpdatedAt",
          "subscription",
          "telegram",
          "telegramConnected",
          "telegramUsername",
          "telegramDisplayName",
          "telegramAvatarUrl",
          "telegramUserId",
          "telegramChatId",
          "telegramLinkedAt",
          "telegramLinkCode",
          "telegramLinkCodeCreatedAt",
          "telegramLinkCodeExpiresAt",
          "telegramNotificationsEnabled",
          "telegramNotificationsUpdatedAt",
          "telegramDisconnectedAt"
        ]);
    }

    function isSafeOwnerUpdate(uid) {
      return isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()) &&
        !request.resource.data.get("accountProfile", {}).diff(resource.data.get("accountProfile", {})).affectedKeys().hasAny(["login", "email"]);
    }

    // Some profiles created before role-based access did not receive a role or
    // retained an older unsupported value. Let only that signed-in owner
    // activate the existing profile as a client. This cannot reactivate an
    // explicitly disabled account or modify a current role.
    function isLegacyClientActivation(uid) {
      return isAuthenticatedOwner(uid) &&
        (
          !resource.data.keys().hasAll(["role"]) ||
          !(resource.data.role in ["client", "trainer", "admin"])
        ) &&
        (!resource.data.keys().hasAll(["active"]) || resource.data.active != false) &&
        (!resource.data.keys().hasAll(["archived"]) || resource.data.archived != true) &&
        (!resource.data.keys().hasAll(["accessDisabled"]) || resource.data.accessDisabled != true) &&
        (!resource.data.keys().hasAll(["membershipStatus"]) ||
          !(resource.data.membershipStatus in ["revoked", "suspended"])) &&
        request.resource.data.role == "client" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "updatedAt"
        ]);
    }

    function hasAssignedTrainerId(data) {
      return data.keys().hasAll(["assignedTrainerId"]) &&
        data.assignedTrainerId is string &&
        data.assignedTrainerId.size() > 0;
    }

    function hasTrainerId(data) {
      return data.keys().hasAll(["trainerId"]) &&
        data.trainerId is string &&
        data.trainerId.size() > 0;
    }

    function hasCoachId(data) {
      return data.keys().hasAll(["coachId"]) &&
        data.coachId is string &&
        data.coachId.size() > 0;
    }

    function hasCreatedByUid(data) {
      return data.keys().hasAll(["createdByUid"]) &&
        data.createdByUid is string &&
        data.createdByUid.size() > 0;
    }

    // Administrative lifecycle operations retain historical creator fields for
    // auditability. Once an explicit state exists, only canonical assignment
    // fields may grant trainer access; an old createdByUid must never keep a
    // reassigned, unassigned, or revoked client visible to a previous trainer.
    function hasExplicitTrainerAssignmentState(data) {
      return data.keys().hasAll(["trainerAssignmentState"]) &&
        data.trainerAssignmentState is string &&
        data.trainerAssignmentState in ["assigned", "unassigned", "revoked"];
    }

    function hasResolvedAssignedTrainer(data) {
      return hasExplicitTrainerAssignmentState(data)
        ? data.trainerAssignmentState == "assigned" && (
          (hasAssignedTrainerId(data) && data.assignedTrainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && hasTrainerId(data) && data.trainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) &&
            hasCoachId(data) && data.coachId == request.auth.uid)
        )
        : (
          (hasAssignedTrainerId(data) && data.assignedTrainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && hasTrainerId(data) && data.trainerId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) &&
            hasCoachId(data) && data.coachId == request.auth.uid) ||
          (!hasAssignedTrainerId(data) && !hasTrainerId(data) && !hasCoachId(data) &&
            hasCreatedByUid(data) && data.createdByUid == request.auth.uid)
        );
    }

    function isAssignedTrainerData(data) {
      return isTrainer() && hasResolvedAssignedTrainer(data);
    }

    function isAssignedTrainer(uid) {
      return isAssignedTrainerData(get(/databases/$(database)/documents/users/$(uid)).data);
    }

    function isOwnedTrainingTemplateForTrainer(templateId) {
      return
        exists(/databases/$(database)/documents/trainingTemplates/$(templateId)) &&
        get(/databases/$(database)/documents/trainingTemplates/$(templateId)).data.ownerUid == request.auth.uid;
    }

    function isOwnedTrainingTemplate(templateId) {
      return isTrainer() && isOwnedTrainingTemplateForTrainer(templateId);
    }

    function isTrainerProgramAssignmentFields() {
      return
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedProgramId",
          "assignedProgramName",
          "assignedProgramAt",
          "assignedProgramAddedAt",
          "assignedProgramUpdatedAt",
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedProgramPublishedAt",
          "assignedProgramAssignedByUid",
          "assignedWorkoutCount",
          "workoutCalendar"
        ]) &&
        request.resource.data.assignedProgramUpdatedAt is string &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["assignedProgramAddedAt"]) ||
          (
            request.resource.data.keys().hasAll(["assignedProgramAddedAt"]) &&
            request.resource.data.assignedProgramAddedAt is string &&
            request.resource.data.assignedProgramAddedAt.size() > 0
          )
        ) &&
        (
          request.resource.data.assignedProgramId == "" ||
          (
            request.resource.data.assignedProgramLifecycleStatus == "active" &&
            request.resource.data.assignedProgramVisibility == "client_active" &&
            request.resource.data.assignedProgramPublishedAt is string &&
            request.resource.data.assignedProgramAssignedByUid == request.auth.uid
          )
        ) &&
        (
          (
            request.resource.data.assignedProgramId == "" &&
            request.resource.data.assignedProgramName == "" &&
            request.resource.data.assignedWorkoutCount == 0
          ) ||
          (
            isOwnedTrainingTemplateForTrainer(request.resource.data.assignedProgramId) &&
            // The client copy has its own editable name; the immutable
            // template ID and ownership, not its display name, grant access.
            request.resource.data.assignedProgramName is string &&
            request.resource.data.assignedProgramName.size() > 0 &&
            request.resource.data.assignedProgramName.size() <= 80
          )
        );
    }

    function isTrainerProgramAssignment() {
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        isTrainerProgramAssignmentFields();
    }

    // Archiving the final active assignment intentionally clears the active
    // program identity from the client profile. Keep this narrow path separate
    // from template assignment so an archive batch stays inexpensive to
    // evaluate and cannot be used to switch a client to another program.
    function isTrainerFinalProgramArchiveFields() {
      return
        resource.data.assignedProgramLifecycleStatus == "active" &&
        resource.data.assignedProgramVisibility == "client_active" &&
        resource.data.assignedProgramAssignedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedProgramId",
          "assignedProgramName",
          "assignedProgramAt",
          "assignedProgramAddedAt",
          "assignedProgramUpdatedAt",
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedWorkoutCount",
          "workoutCalendar"
        ]) &&
        request.resource.data.assignedProgramId == "" &&
        request.resource.data.assignedProgramName == "" &&
        request.resource.data.assignedProgramAddedAt == "" &&
        request.resource.data.assignedProgramUpdatedAt is string &&
        request.resource.data.assignedProgramLifecycleStatus == "archived" &&
        request.resource.data.assignedProgramVisibility == "client_archived" &&
        request.resource.data.assignedWorkoutCount == 0;
    }

    // Restoring a client copy must not require the original trainer template
    // to still exist. The assignment stays tied to the already assigned
    // trainer and can only transition from the archived state back to active.
    function isTrainerProgramAssignmentRestoreFields() {
      return
        resource.data.keys().hasAll(["assignedProgramLifecycleStatus"]) &&
        resource.data.assignedProgramLifecycleStatus == "archived" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedProgramId",
          "assignedProgramName",
          "assignedProgramAt",
          "assignedProgramAddedAt",
          "assignedProgramUpdatedAt",
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedProgramPublishedAt",
          "assignedProgramAssignedByUid",
          "assignedWorkoutCount",
          "workoutCalendar"
        ]) &&
        request.resource.data.assignedProgramId is string &&
        request.resource.data.assignedProgramId.size() > 0 &&
        request.resource.data.assignedProgramName is string &&
        request.resource.data.assignedProgramName.size() > 0 &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["assignedProgramAddedAt"]) ||
          (
            request.resource.data.keys().hasAll(["assignedProgramAddedAt"]) &&
            request.resource.data.assignedProgramAddedAt is string &&
            request.resource.data.assignedProgramAddedAt.size() > 0
          )
        ) &&
        request.resource.data.assignedProgramLifecycleStatus == "active" &&
        request.resource.data.assignedProgramVisibility == "client_active" &&
        request.resource.data.assignedProgramAssignedByUid == request.auth.uid;
    }

    // Saving an individual program editor also synchronizes its calendar and
    // workout count. The assignment identity itself is immutable here so a
    // trainer cannot use this path to switch a client to another template.
    function isTrainerActiveProgramPlanSaveFields() {
      return
        resource.data.assignedProgramLifecycleStatus == "active" &&
        resource.data.assignedProgramVisibility == "client_active" &&
        resource.data.assignedProgramAssignedByUid == request.auth.uid &&
        request.resource.data.assignedProgramId == resource.data.assignedProgramId &&
        request.resource.data.assignedProgramName is string &&
        request.resource.data.assignedProgramName.size() > 0 &&
        request.resource.data.assignedProgramName.size() <= 80 &&
        request.resource.data.assignedProgramUpdatedAt == resource.data.assignedProgramUpdatedAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "workoutCalendar",
          "assignedWorkoutCount",
          "updatedAt",
          "assignedProgramName"
        ]);
    }

    function isTrainerClientScheduleUpdateFields() {
      return
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "workoutCalendar",
          "trainingDays",
          "workoutTime",
          "telegram",
          "telegramNotificationsEnabled",
          "subscription",
          "updatedAt"
        ]) &&
        isTrainerTelegramPreferenceUpdate() &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["telegramNotificationsEnabled"]) ||
          request.resource.data.telegramNotificationsEnabled is bool
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["telegram"]) ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["telegramNotificationsEnabled"]) ||
          request.resource.data.telegram.notificationsEnabled ==
            request.resource.data.telegramNotificationsEnabled
        );
    }

    function isTrainerClientScheduleUpdate() {
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        isTrainerClientScheduleUpdateFields();
    }

    function isTrainerTelegramPreferenceUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["telegram"]) ||
        (
          request.resource.data.telegram is map &&
          (
            (
              !resource.data.keys().hasAll(["telegram"]) &&
              request.resource.data.telegram.keys().hasOnly(["notificationsEnabled"])
            ) ||
            (
              resource.data.keys().hasAll(["telegram"]) &&
              resource.data.telegram is map &&
              request.resource.data.telegram.diff(resource.data.telegram).affectedKeys()
                .hasOnly(["notificationsEnabled"])
            )
          )
        );
    }

    function isTrainerClientArchiveUpdateFields() {
      return
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "archived",
          "active",
          "archivedAt",
          "restoredAt",
          "isTest",
          "updatedAt"
        ]);
    }

    function isTrainerClientArchiveUpdate() {
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        isTrainerClientArchiveUpdateFields();
    }

    // The initial client setup checklist is operational state for the assigned
    // trainer only. Keeping it in its own narrow update branch prevents the
    // checklist from becoming a back door to edit the client's profile.
    function isTrainerClientSetupChecklistUpdateFields() {
      return
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "trainerSetupChecklist",
          "updatedAt"
        ]) &&
        request.resource.data.trainerSetupChecklist is map &&
        request.resource.data.trainerSetupChecklist.keys().hasOnly([
          "version",
          "status",
          "completedSteps",
          "currentStep",
          "startedAt",
          "updatedAt",
          "completedAt"
        ]) &&
        request.resource.data.trainerSetupChecklist.version == 2 &&
        request.resource.data.trainerSetupChecklist.status in ["in_progress", "completed"] &&
        request.resource.data.trainerSetupChecklist.completedSteps is map &&
        request.resource.data.trainerSetupChecklist.completedSteps.keys().hasAll([
          "program",
          "schedule",
          "nutrition",
          "notifications"
        ]) &&
        request.resource.data.trainerSetupChecklist.completedSteps.keys().hasOnly([
          "program",
          "schedule",
          "nutrition",
          "notifications"
        ]) &&
        request.resource.data.trainerSetupChecklist.completedSteps.program is bool &&
        request.resource.data.trainerSetupChecklist.completedSteps.schedule is bool &&
        request.resource.data.trainerSetupChecklist.completedSteps.nutrition is bool &&
        request.resource.data.trainerSetupChecklist.completedSteps.notifications is bool;
    }

    function isTrainerClientSetupChecklistUpdate() {
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        isTrainerClientSetupChecklistUpdateFields();
    }

    function isValidAiNutritionWeek(data) {
      let week = data.week;
      let calories = data.calories;
      let protein = data.protein;
      let fat = data.fat;
      let carbs = data.carbs;
      return data is map &&
        data.keys().hasAll(["week", "calories", "protein", "fat", "carbs"]) &&
        week is int && week >= 1 && week <= 4 &&
        calories is number && calories > 0 && calories <= 20000 &&
        protein is number && protein >= 0 && protein <= 3000 &&
        fat is number && fat >= 0 && fat <= 3000 &&
        carbs is number && carbs >= 0 && carbs <= 5000;
    }

    function isValidAiNutritionPlan(data) {
      let id = data.id;
      let weeks = data.weeks;
      return data is map &&
        data.keys().hasOnly([
          "id", "version", "createdAt", "calorieAnchor", "personalMaintenance",
          "personalBmr", "activityLabel", "profile", "goalLabel", "start", "weeks",
          "baseline", "frequentFoods", "workoutsCount", "weightTrend", "warnings", "comment"
        ]) &&
        id is string && id.size() > 0 && id.size() <= 120 &&
        data.version == 1 && data.createdAt is string &&
        data.profile is map && isValidAiNutritionWeek(data.start) &&
        weeks is list && weeks.size() == 4 &&
        isValidAiNutritionWeek(weeks[0]) && isValidAiNutritionWeek(weeks[1]) &&
        isValidAiNutritionWeek(weeks[2]) && isValidAiNutritionWeek(weeks[3]);
    }

    function isTrainerAiNutritionPlanUpdate(changedKeys) {
      return !changedKeys.hasAny(["aiNutritionPlan"]) ||
        isValidAiNutritionPlan(request.resource.data.aiNutritionPlan);
    }

    function isTrainerNutritionPlanUpdateFields(changedKeys) {
      return
        changedKeys.hasOnly([
          "nutritionGoals",
          "nutritionPlan",
          "nutritionPlanUpdatedAt",
          "aiNutritionPlan",
          "updatedAt"
        ]) && isTrainerAiNutritionPlanUpdate(changedKeys);
    }

    function isTrainerNutritionPlanUpdate() {
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        isTrainerNutritionPlanUpdateFields(request.resource.data.diff(resource.data).affectedKeys());
    }

    function isTrainerClientUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isTrainer() &&
        hasResolvedAssignedTrainer(resource.data) &&
        (
          // AI plans are sizeable maps. Route this disjoint field set before
          // unrelated program/calendar alternatives and reuse its diff once.
          changedKeys.hasAny(["aiNutritionPlan"])
          ? isTrainerNutritionPlanUpdateFields(changedKeys)
          : (
          isTrainerFinalProgramArchiveFields() ||
          isTrainerProgramAssignmentFields() ||
          isTrainerProgramAssignmentRestoreFields() ||
          isTrainerActiveProgramPlanSaveFields() ||
          isTrainerNutritionPlanUpdateFields(changedKeys) ||
          isTrainerClientScheduleUpdateFields() ||
          isTrainerClientArchiveUpdateFields() ||
          isTrainerClientSetupChecklistUpdate()
          )
        );
    }

    function trainerNutritionStateFields() {
      return [
        "goals",
        "nutritionPlan",
        "aiNutritionPlan",
        "updatedAt"
      ];
    }

    function isTrainerNutritionStatePlanCreate(uid, docId) {
      return docId == "state" &&
        isAssignedTrainer(uid) &&
        request.resource.data.keys().hasOnly(trainerNutritionStateFields()) &&
        (!request.resource.data.keys().hasAny(["aiNutritionPlan"]) ||
          isValidAiNutritionPlan(request.resource.data.aiNutritionPlan));
    }

    function isTrainerNutritionStatePlanUpdate(uid, docId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return docId == "state" &&
        isAssignedTrainer(uid) &&
        changedKeys.hasOnly(trainerNutritionStateFields()) &&
        isTrainerAiNutritionPlanUpdate(changedKeys);
    }

    function isTrainerOutgoingMessage(uid) {
      return isTrainer() &&
        isAssignedTrainer(uid) &&
        (
          request.resource.data.keys().hasOnly([
            "type",
            "direction",
            "text",
            "status",
            "sentAt",
            "sentByUid",
            "sentByEmail"
          ]) ||
          request.resource.data.keys().hasOnly([
            "type",
            "direction",
            "text",
            "status",
            "sentAt",
            "sentByUid",
            "sentByEmail",
            "sourceCommentId",
            "workoutId",
            "exerciseId",
            "replyContext"
          ])
        ) &&
        request.resource.data.type == "manual" &&
        request.resource.data.direction == "out" &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.sentAt is string &&
        request.resource.data.sentByUid == request.auth.uid &&
        request.resource.data.sentByEmail is string &&
        (
          request.resource.data.status == "saved" ||
          (
            request.resource.data.status == "sending" &&
            request.resource.data.sourceCommentId is string &&
            request.resource.data.sourceCommentId.size() > 0 &&
            request.resource.data.workoutId is string &&
            request.resource.data.exerciseId is string &&
            request.resource.data.replyContext is map
          )
        );
    }

    function isTrainerOutgoingMessageDeliveryUpdate(uid) {
      return isTrainer() &&
        isAssignedTrainer(uid) &&
        resource.data.type == "manual" &&
        resource.data.direction == "out" &&
        resource.data.sentByUid == request.auth.uid &&
        resource.data.sourceCommentId is string &&
        resource.data.sourceCommentId.size() > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "channel",
          "deliveredAt"
        ]) &&
        request.resource.data.status in ["sent", "error"] &&
        (
          request.resource.data.status == "error" ||
          (
            request.resource.data.channel in ["telegram", "internal"] &&
            request.resource.data.deliveredAt is string
          )
        );
    }

    function isTrainerMessageReadUpdate(uid) {
      return isTrainer() &&
        isAssignedTrainer(uid) &&
        resource.data.type == "incoming" &&
        resource.data.direction == "in" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "trainerReadAt",
          "trainerReadByUid"
        ]) &&
        request.resource.data.trainerReadAt is string &&
        request.resource.data.trainerReadByUid == request.auth.uid;
    }

    function isTrainerCreatingAssignedClient(uid) {
      return isTrainer() &&
        !uid.matches("^telegram_.*") &&
        // Authentication, Telegram identity and lifecycle metadata are issued
        // only by trusted invitation endpoints, never by a trainer SDK write.
        request.resource.data.keys().hasOnly([
          "email", "name", "role", "active", "createdAt", "updatedAt",
          "createdBy", "createdByEmail", "createdByUid", "trainerId",
          "assignedTrainerId", "coachId", "trainerEmail", "assignedTrainerEmail",
          "coachEmail", "assignedProgramId", "assignedProgramName"
        ]) &&
        request.resource.data.role == "client" &&
        request.resource.data.createdByUid == request.auth.uid &&
        isAssignedTrainerData(request.resource.data);
    }

    function inviteFields() {
      return [
        "email",
        "name",
        "status",
        "authUid",
        "trainerId",
        "trainerEmail",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt",
        "inviteUrl",
        "acceptedAt",
        "acceptedUid"
      ];
    }

    function isTrainerInviteWrite() {
      return (isAdmin() || isTrainer()) &&
        request.resource.data.keys().hasOnly(inviteFields()) &&
        request.resource.data.email is string &&
        request.resource.data.status in ["active", "created", "accepted", "revoked"] &&
        (
          isAdmin() ||
          (
            request.resource.data.trainerId == request.auth.uid &&
            request.resource.data.createdByUid == request.auth.uid
          )
        );
    }

    // Trainers may maintain their own invitation, but an existing invitation
    // cannot be claimed by another trainer through an update request.
    function isTrainerInviteOwnerUpdate() {
      return isTrainerInviteWrite() && (
        isAdmin() ||
        (
          resource.data.trainerId == request.auth.uid &&
          resource.data.createdByUid == request.auth.uid &&
          request.resource.data.trainerId == resource.data.trainerId &&
          request.resource.data.createdByUid == resource.data.createdByUid
        )
      );
    }

    function isInviteAcceptance() {
      return signedIn() &&
        resource.data.status in ["active", "created"] &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        (
          !resource.data.keys().hasAll(["authUid"]) ||
          resource.data.authUid == "" ||
          resource.data.authUid == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "acceptedAt",
          "acceptedUid",
          "updatedAt"
        ]) &&
        request.resource.data.status == "accepted" &&
        request.resource.data.acceptedUid == request.auth.uid;
    }

    function isInvitedOwnerCreate(uid) {
      return isAuthenticatedOwner(uid) &&
        request.resource.data.keys().hasOnly([
          "email", "name", "role", "active", "createdAt", "updatedAt",
          "authProvider", "inviteActivatedAt", "createdBy", "createdByEmail",
          "createdByUid", "trainerId", "assignedTrainerId", "coachId",
          "trainerEmail", "assignedTrainerEmail", "coachEmail"
        ]) &&
        request.resource.data.get("active", true) == true &&
        exists(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.status in ["active", "created"] &&
        (
          !get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data
            .keys().hasAll(["authUid"]) ||
          get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.authUid == "" ||
          get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.authUid == uid
        ) &&
        request.resource.data.role == "client" &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.trainerId == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerId &&
        request.resource.data.assignedTrainerId == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerId &&
        request.resource.data.coachId == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerId &&
        request.resource.data.createdByUid == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerId &&
        request.resource.data.trainerEmail == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerEmail &&
        request.resource.data.assignedTrainerEmail == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerEmail &&
        request.resource.data.coachEmail == get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email)).data.trainerEmail;
    }

    function isOpenRegistrationOwnerCreate(uid) {
      return isAuthenticatedOwner(uid) &&
        request.resource.data.keys().hasOnly([
          "email", "name", "role", "active", "createdAt", "updatedAt",
          "authProvider", "accountRegistrationType", "accountAccessStatus"
        ]) &&
        request.resource.data.keys().hasAll([
          "email", "name", "role", "active", "createdAt", "updatedAt",
          "authProvider", "accountRegistrationType", "accountAccessStatus"
        ]) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.role == "client" &&
        request.resource.data.active == true &&
        request.resource.data.accountRegistrationType == "open" &&
        request.resource.data.accountAccessStatus == "awaiting_trainer" &&
        request.resource.data.authProvider in ["password", "google.com"] &&
        request.auth.token.firebase.sign_in_provider in ["password", "google.com"] &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
    }

    function isPendingClientOwner(uid, data) {
      return isAuthenticatedOwner(uid) &&
        data.role == "client" &&
        (data.get("accountAccessStatus", "") == "awaiting_trainer" || data.get("trainerAssignmentState", "") == "unassigned") &&
        (!data.keys().hasAll(["active"]) || data.active != false) &&
        (!data.keys().hasAll(["archived"]) || data.archived != true) &&
        (!data.keys().hasAll(["accessDisabled"]) || data.accessDisabled != true) &&
        (!data.keys().hasAll(["membershipStatus"]) ||
          !(data.membershipStatus in ["revoked", "suspended"]));
    }

    function isTrainerOwnedProgramWorkoutCreate(uid) {
      return isTrainer() &&
        isAssignedTrainer(uid) &&
        request.resource.data.assignedBy == request.auth.uid &&
        isOwnedTrainingTemplate(request.resource.data.assignedProgramId) &&
        request.resource.data.assignedProgramName ==
          get(/databases/$(database)/documents/trainingTemplates/$(request.resource.data.assignedProgramId)).data.name;
    }

    // Adding a day to an existing client copy does not require its library
    // template to still exist. The active assignment and trainer stay fixed.
    function isTrainerClientProgramDayCreate(uid) {
      let client = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return isTrainer() && isAssignedTrainer(uid) &&
        client.assignedProgramAssignedByUid == request.auth.uid &&
        client.assignedProgramLifecycleStatus == "active" &&
        client.assignedProgramVisibility == "client_active" &&
        request.resource.data.assignedBy == request.auth.uid &&
        request.resource.data.assignedProgramId == client.assignedProgramId &&
        request.resource.data.assignedProgramUpdatedAt == client.assignedProgramUpdatedAt &&
        request.resource.data.assignedProgramName == client.assignedProgramName &&
        !isTrainerWorkoutStarted(request.resource.data);
    }

    function isTrainerWorkoutStarted(data) {
      return
        (data.keys().hasAll(["completed"]) && data.completed == true) ||
        (data.keys().hasAll(["completedAt"]) && data.completedAt is string && data.completedAt.size() > 0) ||
        (data.keys().hasAll(["status"]) && data.status in ["completed", "completed_off_date", "missed"]);
    }

    // Keep access resolution outside the individual lifecycle checks. A
    // restore updates every workout in a saved program in one batch; repeating
    // the trainer/client lookup for each alternative rule branch can hit the
    // Firestore expression limit before the valid branch is reached.
    function isTrainerManagingClientWorkouts(uid) {
      return isTrainer() && isAssignedTrainer(uid);
    }

    function isTrainerUnfinishedProgramWorkoutUpdateFields() {
      return resource.data.assignedBy == request.auth.uid &&
        !isTrainerWorkoutStarted(resource.data) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["assignedProgramName"]) || (
          request.resource.data.assignedProgramName is string &&
          request.resource.data.assignedProgramName.size() > 0 &&
          request.resource.data.assignedProgramName.size() <= 80
        )) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "assignedBy",
          "assignedProgramId",
          "assignedProgramAddedAt"
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "exercises",
          "order",
          "sortOrder",
          "scheduledDate",
          "plannedDate",
          "scheduleOrder",
          "status",
          "statusUpdatedAt",
          "movedToDate",
          "updatedAt",
          "assignedProgramName"
        ]);
    }

    function isTrainerArchivedProgramWorkoutRestoreFields() {
      return resource.data.assignedBy == request.auth.uid &&
        resource.data.assignedProgramLifecycleStatus == "archived" &&
        request.resource.data.assignedProgramLifecycleStatus == "active" &&
        request.resource.data.assignedProgramVisibility == "client_active" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "assignedBy",
          "assignedProgramId",
          "assignedProgramName",
          "assignedProgramAddedAt",
          "name",
          "exercises",
          "order",
          "sortOrder",
          "scheduledDate",
          "plannedDate",
          "scheduleOrder",
          "status",
          "statusUpdatedAt",
          "completed",
          "completedAt",
          "movedToDate"
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedProgramPublishedAt",
          "assignedProgramAssignedByUid",
          "assignedProgramArchivedAt"
        ]);
    }

    function isValidProgramArchiveCalendarBackup(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let backup = request.resource.data.get("assignedProgramArchivedCalendarEntries", []);
      let calendar = get(/databases/$(database)/documents/users/$(uid)).data.get("workoutCalendar", {});
      let entries = calendar is map ? calendar.get("plannedWorkouts", []) : [];
      // This field is a backup, not a new calendar writer. New contents must
      // come verbatim from this client's calendar before the atomic archive.
      return !changed.hasAny(["assignedProgramArchivedCalendarEntries"]) || (
        backup is list && backup.size() <= 400 &&
        (backup.size() == 0 || (entries is list && backup.hasOnly(entries)))
      );
    }

    function isTrainerProgramWorkoutArchiveFields(uid) {
      return resource.data.assignedBy == request.auth.uid &&
        request.resource.data.assignedProgramLifecycleStatus == "archived" &&
        request.resource.data.assignedProgramVisibility == "trainer_archived" &&
        isValidProgramArchiveCalendarBackup(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedProgramLifecycleStatus",
          "assignedProgramVisibility",
          "assignedProgramArchivedAt",
          "assignedProgramArchivedCalendarEntries"
        ]);
    }

    function isTrainerUnstartedProgramWorkoutDelete(uid) {
      return isTrainer() &&
        isAssignedTrainer(uid) &&
        resource.data.assignedBy == request.auth.uid &&
        !isTrainerWorkoutStarted(resource.data);
    }

    match /loginAliases/{aliasId} {
      allow read: if isActiveMember() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
      // Login identity is mutated only by the ownership-checked server transaction.
      allow write: if isAdmin();
    }

    match /clientInvites/{inviteId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.email == request.auth.token.email ||
        (
          isTrainer() &&
          (
            resource.data.trainerId == request.auth.uid ||
            resource.data.createdByUid == request.auth.uid
          )
        )
      );
      allow create: if isTrainerInviteWrite();
      allow update: if isTrainerInviteOwnerUpdate() || isInviteAcceptance();
      allow delete: if isAdmin() || (isTrainer() && resource.data.trainerId == request.auth.uid);
    }

    // Audit records are written only by trusted server-side administrative
    // endpoints. Administrators may inspect them, but clients and trainers
    // cannot read or forge lifecycle history.
    match /adminAuditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Link codes are credentials. Even an assigned trainer must not read them;
    // only authenticated server issuance/redemption may inspect these records.
    match /telegramLinkCodes/{codeId} {
      allow read, write: if false;
    }

    // Credential public keys and one-use ceremonies are available only to
    // the trusted authentication service, never to browser SDKs (even admins).
    match /adminSecurityKeys/{uid}/{allPaths=**} {
      allow read, write: if false;
    }

    match /adminSecurityKeyChallenges/{challengeId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow create: if !request.resource.data.keys().hasAny(adminSecurityKeyFields()) &&
        (isAdmin() || isInvitedOwnerCreate(uid) || isOpenRegistrationOwnerCreate(uid) || isTrainerCreatingAssignedClient(uid));
      // A signed-in user may check that their own bootstrap profile is absent
      // before creating a restricted open-registration profile. This grants
      // no access to another UID or to any member subcollection.
      allow get: if isOwnerOrAdmin(uid) || isAssignedTrainerData(resource.data) ||
        isPendingClientOwner(uid, resource.data) ||
        (isAuthenticatedOwner(uid) && !exists(/databases/$(database)/documents/users/$(uid)));
      allow list: if isOwnerOrAdmin(uid) || isAssignedTrainerData(resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminSecurityKeyFields()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["subscription"]) || accountingWritesAvailable()) &&
        (isAdmin() || isSafeOwnerUpdate(uid) || isLegacyClientActivation(uid) || isTrainerClientUpdate());
      // Prevent a browser administrator from bypassing enrollment by deleting
      // and recreating a protected profile. Server account deletion still works.
      allow delete: if isAdmin() && !resource.data.keys().hasAny(adminSecurityKeyFields());

      match /workouts/{workoutId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow create: if isOwnerOrAdmin(uid) || isTrainerClientProgramDayCreate(uid) || isTrainerOwnedProgramWorkoutCreate(uid);
      // Restore is deliberately checked first. A client program can contain
      // many archived workout documents, restored in one batch. Evaluating
      // the broad edit/archive branches for every document first can exceed
      // Firestore's rule-expression budget and rejects an otherwise valid
      // restore operation.
      allow update: if isOwnerOrAdmin(uid) || (
        isTrainerManagingClientWorkouts(uid) && (
          isTrainerArchivedProgramWorkoutRestoreFields() ||
          isTrainerProgramWorkoutArchiveFields(uid) ||
          isTrainerUnfinishedProgramWorkoutUpdateFields()
        )
      );
        allow delete: if isOwnerOrAdmin(uid) || isTrainerUnstartedProgramWorkoutDelete(uid);
      }

      match /history/{historyId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        // Accounting markers are issued by server triggers, never the owner SDK.
        allow create: if isOwnerOrAdmin(uid) && accountingWritesAvailable() &&
          !request.resource.data.keys().hasAny(["subscriptionCycleId", "subscriptionUsageLedgerId", "subscriptionAccountedAt"]);
        allow update: if isOwnerOrAdmin(uid) && accountingWritesAvailable() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["subscriptionCycleId", "subscriptionUsageLedgerId", "subscriptionAccountedAt"]);
        allow delete: if isOwnerOrAdmin(uid) && accountingWritesAvailable();
      }

      match /historyTombstones/{historyId} {
        allow read, write: if isOwnerOrAdmin(uid);
      }

      match /nutrition/{docId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        // A trusted API is the only writer of manifest/generations/receipts.
        // Once the writer epoch advances, an old tab may keep a local outbox
        // but must never successfully write into the frozen legacy document.
        allow create: if nutritionSdkWriteAvailable(uid, docId) &&
          (isOwnerOrAdmin(uid) || isTrainerNutritionStatePlanCreate(uid, docId));
        allow update: if nutritionSdkWriteAvailable(uid, docId) &&
          (isOwnerOrAdmin(uid) || isTrainerNutritionStatePlanUpdate(uid, docId));
        allow delete: if nutritionSdkWriteAvailable(uid, docId) && isOwnerOrAdmin(uid);
      }

      match /nutrition/{docId}/{subPath=**} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow write: if nutritionSdkWriteAvailable(uid, docId) && isOwnerOrAdmin(uid);
      }

      match /measurements/{measurementId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow write: if isOwnerOrAdmin(uid);
      }

      match /trainerTasks/{taskId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow create, delete: if isAdmin() || (isTrainer() && isAssignedTrainer(uid));
        allow update: if isAdmin() ||
          (isTrainer() && isAssignedTrainer(uid)) ||
          (
            isOwner(uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "completedAt",
              "updatedAt"
            ])
          );
      }

      match /progressPhotos/{photoId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow write: if isOwnerOrAdmin(uid) || (isTrainer() && isAssignedTrainer(uid));
      }

      match /trainerEvents/{eventId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow create: if isOwnerOrAdmin(uid) || (isTrainer() && isAssignedTrainer(uid));
        allow update, delete: if isAdmin() || (isTrainer() && isAssignedTrainer(uid));
      }

      match /payments/{paymentId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow write: if isAdmin() || (isTrainer() && isAssignedTrainer(uid));
      }

      match /telegramMessages/{messageId} {
        allow read: if isOwnerOrAdmin(uid) || isAssignedTrainer(uid);
        allow create: if isOwnerOrAdmin(uid) || isTrainerOutgoingMessage(uid);
        allow update: if isOwnerOrAdmin(uid) || isTrainerMessageReadUpdate(uid) || isTrainerOutgoingMessageDeliveryUpdate(uid);
        allow delete: if isOwnerOrAdmin(uid);
      }

      match /{collectionId}/{subPath=**} {
        allow read: if isAdmin();
        // History has a stricter accounting/maintenance contract above. A
        // recursive admin fallback must not silently OR around that contract.
        allow write: if !(collectionId in ["history", "nutrition", "nutritionGenerations", "nutritionMutationReceipts"]) && isAdmin();
      }

      match /feedback/{feedbackId} {
        allow read, create: if isOwnerOrAdmin(uid);
      }

      match /trainerClients/{clientId} {
        allow read, write: if isAdmin() || (isTrainer() && isOwner(uid));
      }
    }

    match /trainerNotes/{noteId} {
      allow read: if isAdmin() || (
        isTrainer() &&
        resource.data.ownerUid == request.auth.uid &&
        isAssignedTrainer(resource.data.clientId)
      );
      allow create: if isAdmin() || (
        isTrainer() &&
        request.resource.data.ownerUid == request.auth.uid &&
        isAssignedTrainer(request.resource.data.clientId)
      );
      allow update: if isAdmin() || (
        isTrainer() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.clientId == resource.data.clientId &&
        isAssignedTrainer(resource.data.clientId)
      );
      allow delete: if isAdmin() || (
        isTrainer() && resource.data.ownerUid == request.auth.uid &&
        isAssignedTrainer(resource.data.clientId)
      );
    }

    // Общая база продуктов: читать могут авторизованные, писать только admin.
    match /nutritionGlobal/{docId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    match /nutritionGlobal/{docId}/{subPath=**} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // Админские системные документы.
    match /basicExerciseOverrides/{exerciseId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // Managed base programs are a separate administrator-owned lifecycle.
    // The current document may evolve, but every published/draft snapshot is
    // append-only so the audit history cannot be rewritten from the browser.
    match /admin/basicProgramTemplates/items/{programId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin/{docId}/{subPath=**} {
      // The dedicated basic-program match above deliberately owns this
      // subtree. Other system documents retain the existing admin policy.
      allow read, write: if isAdmin() && docId != "basicProgramTemplates";
    }


    // Библиотека программ тренировок
    match /trainingTemplates/{templateId} {
      allow read: if isAdmin() || (
        isTrainer() &&
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if (
        isAdmin() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerRole == "admin" &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid
      ) || (
        isTrainer() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerRole == "trainer" &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isTrainer() &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.ownerRole == "trainer" &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerRole == "trainer" &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.updatedByUid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isTrainer() &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.ownerRole == "trainer"
      );
    }

    match /trainingTemplates/{templateId}/{subPath=**} {
      allow read, write: if isAdmin() || (
        isTrainer() &&
        exists(/databases/$(database)/documents/trainingTemplates/$(templateId)) &&
        get(/databases/$(database)/documents/trainingTemplates/$(templateId)).data.ownerUid == request.auth.uid
      );
    }

    // Shared metadata is served by owner-scoped APIs, never by a client-wide
    // catalogue query. Prescription and history remain in their existing paths.
    match /trainerExerciseCards/{cardId} {
      allow read, write: if false;
    }

    // По умолчанию всё закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
